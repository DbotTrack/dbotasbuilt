# Loaded by `npm run dev` only — `vite build` never reads this file, so a
# production build keeps the default https://app.dbotasbuilt.com.
# Override per machine in `.env.development.local` (git-ignored).

# The client app's dev server. 5173 is the port its backend allows for CORS and
# builds password-reset links from, which is why this site runs on 3000.
VITE_CLIENT_APP_URL=http://localhost:5173
